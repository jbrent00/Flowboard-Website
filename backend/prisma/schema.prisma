generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id
  firstName    String?
  lastName     String?
  primaryEmail String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasksCreated Task[]
  projectTasksCreated ProjectTask[]
  tags         Tag[]
  memberships  ProjectMembership[]
  verifiedEmails UserEmail[]
  invitationsSent ProjectInvitation[]
}

model UserEmail {
  userId          String
  normalizedEmail String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, normalizedEmail])
  @@index([normalizedEmail])
}

model Project {
  id          Int                 @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships ProjectMembership[]
  tasks       ProjectTask[]
  tags        ProjectTag[]
  invitations ProjectInvitation[]
}

model ProjectMembership {
  projectId Int
  userId    String
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, role])
}

model ProjectInvitation {
  id              Int              @id @default(autoincrement())
  projectId       Int
  inviterId       String
  email           String
  normalizedEmail String
  role            InvitationRole
  status          InvitationStatus @default(pending)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter         User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail, status, expiresAt])
  @@index([projectId, status, expiresAt])
}

model ProjectTask {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(low)
  dueDate     DateTime?
  completedAt DateTime?
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projectId   Int
  createdById String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  taskTags    ProjectTaskTag[]

  @@index([projectId, status, orderIndex])
}

model ProjectTag {
  id             Int              @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  projectId      Int
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTags       ProjectTaskTag[]

  @@unique([projectId, normalizedName])
}

model ProjectTaskTag {
  taskId Int
  tagId  Int
  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    ProjectTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Task {
  id             Int             @id @default(autoincrement())
  title          String
  description    String?
  status         TaskStatus      @default(todo)
  priority       TaskPriority    @default(low)
  dueDate        DateTime?
  completedAt    DateTime?
  orderIndex     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]
  checklistItems ChecklistItem[]

  @@index([createdById, status, orderIndex])
}

model Tag {
  id             Int       @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]

  @@unique([userId, normalizedName])
}

model TaskTag {
  taskId Int
  tagId  Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model ChecklistItem {
  id         Int     @id @default(autoincrement())
  text       String
  completed  Boolean @default(false)
  orderIndex Int     @default(0)
  taskId     Int
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, orderIndex])
}

enum TaskStatus {
  todo
  in_progress
  completed
}

enum TaskPriority {
  low
  medium
  high
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum InvitationRole {
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}
